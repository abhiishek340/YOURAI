# Server port is fixed at 5000 in index.js

# MongoDB connection string
MONGODB_URI=

# Google OAuth 2.0 credentials (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Local Piper text-to-speech (optional)
PIPER_PATH=
PIPER_MODEL_PATH=

# Secret used to sign login tokens (any long random string)
JWT_SECRET=
